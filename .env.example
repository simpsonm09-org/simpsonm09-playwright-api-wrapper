# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Shared secret required on every route except the health checks.
# Must not be the development default when NODE_ENV=production.
API_KEY=dev-local-key

# Comma-separated allowlist entries. Each entry is scheme://host[:port][/path].
# Matching requires the scheme, host, and port to match and the request path to
# start with the entry's path prefix. Default is locked to local fixtures.
ALLOWED_TARGETS=http://localhost:4010,http://127.0.0.1:4010,http://fixture:4010

# Optional JSON file of named scenarios. Each key is a flow name and each value
# holds a steps array (and optional options). A request may send flow: "name"
# instead of an inline steps array. Path is relative to the process working dir.
FLOWS_FILE=flows/flows.json

RUN_TIMEOUT_MS=60000
STEP_TIMEOUT_MS=15000
MAX_STEPS=100
MAX_BODY_BYTES=262144
MAX_CONCURRENT_RUNS=2
MAX_OUTPUTS_BYTES=65536

# Extra Chromium launch arguments, comma separated. Empty locally.
# Containers without a usable Chromium sandbox need --no-sandbox.
CHROMIUM_ARGS=

# Server-side secrets referenced from a step as ${secret.NAME}.
# Only RUN_SECRET_ variables are exposed to templates.
# RUN_SECRET_LOGIN_PASSWORD=replace-me
